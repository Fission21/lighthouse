# 让编辑器统一缩进/换行/编码（不需要装插件也能生效于主流编辑器）
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 110

[*.{json,jsonc,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.sh]
indent_size = 2
